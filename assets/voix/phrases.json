{
"cat": "Encouragements",
"text": "Plus que trois, vous y êtes presque"
},
{
"cat": "Encouragements",
"text": "Dernière !"
},
{
"cat": "Encouragements",
"text": "La dernière, la plus belle."
},
{
"cat": "Encouragements",
"text": "Dernière, on termine en beauté."
},
{
"cat": "Encouragements",
"text": "Et la dernière !"
},
{
"cat": "Encouragements",
"text": "On tient, vous êtes solide."
},
{
"cat": "Encouragements",
"text": "Respirez, ne bloquez pas."
},
{
"cat": "Encouragements",
"text": "C'est là que le muscle travaille."
},
{
"cat": "Encouragements",
"text": "Encore un peu, vous tenez bon."
},
{
"cat": "Encouragements",
"text": "Solide comme un roc."
},
{
"cat": "Encouragements",
"text": "La moitié, on tient."
},
{
"cat": "Encouragements",
"text": "Mi-temps ! Respirez calmement."
},
{
"cat": "Encouragements",
"text": "Déjà la moitié, bravo."
},
{
"cat": "Encouragements",
"text": "Vous êtes solide, on continue."
},
{
"cat": "Encouragements",
"text": "Plus que dix secondes."
},
{
"cat": "Encouragements",
"text": "Dix secondes, on serre les dents."
},
{
"cat": "Encouragements",
"text": "Dix dernières secondes, vous y êtes."
},
{
"cat": "Encouragements",
"text": "Série terminée. Bravo !"
},
{
"cat": "Encouragements",
"text": "Et voilà, série bouclée !"
},
{
"cat": "Encouragements",
"text": "Série terminée, joli travail."
},
{
"cat": "Encouragements",
"text": "Fini ! Soufflez un coup."
},
{
"cat": "Encouragements",
"text": "Une série de plus au compteur, bravo."
},
{
"cat": "Encouragements",
"text": "Allez !"
},
{
"cat": "Encouragements",
"text": "C'est reparti !"
},
{
"cat": "Encouragements",
"text": "On y retourne."
