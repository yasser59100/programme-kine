rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Compte du kiné (connexion Google)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "yasser59100@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Programme officiel : lu par tous, modifié seulement par le kiné
    match /programme/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Communauté : lecture pour tous ; on publie seulement sous son propre compte ;
    // on supprime ses propres messages, le kiné peut tout modérer
    match /messages/{msgId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Compteur anonyme des séances terminées
    match /completions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['j', 'timestamp'])
        && request.resource.data.j is string && request.resource.data.j.size() < 20;
      allow update, delete: if isAdmin();
    }

    // Notifications du jour : clé publique publiée par l'envoyeur
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Rapports de bugs (automatiques ou envoyés par le patient) : anonymes, écriture seule, lus seulement par le kiné
    match /bugs/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['k', 'm', 'src', 'st', 'v', 'ua', 'scr', 'pg', 'sa', 'n', 'log', 't'])
        && request.resource.data.k in ['auto', 'user']
        && request.resource.data.m is string && request.resource.data.m.size() <= 1200
        && (!('st' in request.resource.data) || (request.resource.data.st is string && request.resource.data.st.size() <= 1500))
        && (!('log' in request.resource.data) || (request.resource.data.log is string && request.resource.data.log.size() <= 1500))
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 400;
      allow update: if false;
    }

    // Statistiques d'usage anonymes (numéro au hasard renouvelé chaque mois) : écriture seule, lues seulement par le kiné
    match /stats/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['s', 'v', 'd', 'i', 'e', 't'])
        && request.resource.data.s is string && request.resource.data.s.size() <= 20
        && request.resource.data.v is string && request.resource.data.v.size() <= 30
        && request.resource.data.d in ['ios', 'android', 'autre']
        && request.resource.data.i is bool
        && request.resource.data.e is list && request.resource.data.e.size() <= 40
        && request.resource.data.t == request.time;
      allow update: if false;
    }

    // Abonnements aux notifications : chaque téléphone écrit le sien, personne ne peut les lire
    match /push/{id} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['sub', 'hour', 'kind', 'tz', 'created', 'last'])
        && request.resource.data.hour is int && request.resource.data.hour >= 6 && request.resource.data.hour <= 22
        && request.resource.data.kind in ['both', 'savoir', 'vf']
        && request.resource.data.tz is string && request.resource.data.tz.size() < 60
        && request.resource.data.sub.endpoint is string && request.resource.data.sub.endpoint.matches('https://.*');
      allow delete: if true;
    }

    // ── Suivi au cabinet ──
    // Le patient (accès anonyme ouvert avec le code du kiné) est « membre » de sa fiche : il la lit, il ne la modifie pas.
    function isMember(pid) {
      return request.auth != null && exists(/databases/$(database)/documents/patients/$(pid)/membres/$(request.auth.uid));
    }
    // Codes d'accès : lus un par un (jamais listés), créés par le kiné, supprimés par le patient qui vient de les utiliser
    match /codes/{code} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && exists(/databases/$(database)/documents/patients/$(resource.data.pid)/membres/$(request.auth.uid)));
    }
    // Demandes d'accès sans code : le patient écrit la sienne (prénom, nom, un mot), seul le kiné les lit
    match /demandes/{uid} {
      allow read, delete: if isAdmin();
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['prenom', 'nom', 'msg', 't'])
        && request.resource.data.prenom is string && request.resource.data.prenom.size() >= 1 && request.resource.data.prenom.size() <= 40
        && request.resource.data.nom is string && request.resource.data.nom.size() >= 1 && request.resource.data.nom.size() <= 40
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 160
        && request.resource.data.t == request.time;
    }
    // Réponse à une demande : écrite par le kiné, lue puis effacée par le téléphone du patient
    match /liens/{uid} {
      allow read, write: if isAdmin();
      allow get, delete: if request.auth != null && request.auth.uid == uid;
    }
    // Abonnements aux notifications du kiné (nouvelles demandes) : seulement le kiné
    match /kinepush/{id} {
      allow read, write: if isAdmin();
    }
    // Suivi rattaché à un compte Google : le patient retrouve sa fiche sur un autre téléphone
    match /acces/{uid} {
      allow read, write: if isAdmin();
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pid', 't'])
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 40
        && exists(/databases/$(database)/documents/patients/$(request.resource.data.pid)/membres/$(request.auth.uid))
        && request.resource.data.t == request.time;
    }
    match /patients/{pid} {
      allow read, write: if isAdmin();
      allow get: if isMember(pid);
      match /bilans/{id} {
        allow read, write: if isAdmin();
        allow read: if isMember(pid);
      }
      match /seances/{id} {
        allow read, write: if isAdmin();
        allow read: if isMember(pid);
      }
      // Notes du kiné : lues seulement par le kiné
      match /notes/{id} {
        allow read, write: if isAdmin();
      }
      // Résumé des séances faites à la maison : écrit par le téléphone du patient, une fiche par semaine
      match /maison/{w} {
        allow read, write: if isAdmin();
        allow read: if isMember(pid);
        allow create, update: if isMember(pid)
          && request.resource.data.keys().hasOnly(['w', 'n', 'dou', 'der', 'eff', 't'])
          && request.resource.data.w == w && w.size() <= 10
          && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 50
          && (!('dou' in request.resource.data) || request.resource.data.dou == null || (request.resource.data.dou is number && request.resource.data.dou >= 0 && request.resource.data.dou <= 10))
          && (!('eff' in request.resource.data) || request.resource.data.eff == null || (request.resource.data.eff is number && request.resource.data.eff >= 0 && request.resource.data.eff <= 10))
          && (!('der' in request.resource.data) || (request.resource.data.der is string && request.resource.data.der.size() <= 10))
          && request.resource.data.t == request.time;
      }
      // Rejoindre sa fiche : avec un code valide qui pointe vers cette fiche
      match /membres/{uid} {
        allow read, write: if isAdmin();
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['code', 't'])
          && request.resource.data.code is string && request.resource.data.code.size() <= 12
          && exists(/databases/$(database)/documents/codes/$(request.resource.data.code))
          && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.pid == pid
          && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.exp > request.time
          && request.resource.data.t == request.time;
      }
    }
  }
}
