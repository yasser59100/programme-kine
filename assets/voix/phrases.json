"cat": "Consignes des exercices",
"text": "Talons au sol, genoux dans l'axe des pieds, dos neutre. Serrez les fessiers en remontant."
},
{
"cat": "Consignes des exercices",
"text": "Genou avant au-dessus du pied, genou arrière vers le sol, buste droit."
},
{
"cat": "Consignes des exercices",
"text": "Dos plaqué au mur, genoux au-dessus des chevilles, respirez normalement."
},
{
"cat": "Consignes des exercices",
"text": "Poussez dans les talons jusqu'à aligner épaules, hanches et genoux."
},
{
"cat": "Consignes des exercices",
"text": "Montez le plus haut possible, redescendez lentement."
},
{
"cat": "Consignes des exercices",
"text": "Poussez sur le pied posé sur la marche, sans vous aider de l'autre jambe."
},
{
"cat": "Consignes des exercices",
"text": "Coude collé au flanc, l'avant-bras monte vers le plafond."
},
{
"cat": "Consignes des exercices",
"text": "Corps aligné, coudes à 45° du tronc, descente lente."
},
{
"cat": "Consignes des exercices",
"text": "Épaules basses et en arrière, coudes à 90° maximum."
},
{
"cat": "Consignes des exercices",
"text": "Hanches hautes, amenez la tête entre les mains."
},
{
"cat": "Consignes des exercices",
"text": "Y : levez bras et jambes. W : rapprochez les omoplates."
},
{
"cat": "Consignes des exercices",
"text": "Épaules décollées à 30°, expirez en montant, sans tirer sur la nuque."
},
{
"cat": "Consignes des exercices",
"text": "Le bas du dos reste collé au sol."
},
{
"cat": "Consignes des exercices",
"text": "Corps aligné, ni cambré ni fessiers relevés, respiration libre."
},
{
"cat": "Consignes des exercices",
"text": "Levez les hanches jusqu'à aligner épaule, hanche et genou."
},
{
"cat": "Consignes des exercices",
"text": "Genoux dans l'axe des orteils, remontée en serrant fessiers et adducteurs."
},
{
"cat": "Consignes des exercices",
"text": "La cuisse monte vers le plafond, le bassin ne tourne pas."
},
{
"cat": "Consignes des exercices",
"text": "Alignez épaules, hanches et genoux, sans cambrer le bas du dos."
},
{
"cat": "Consignes des exercices",
"text": "Pieds joints, ouvrez le genou, bassin immobile."
},
{
"cat": "Consignes des exercices",
"text": "Jambe tendue sur le côté, sans pencher le buste."
},
{
"cat": "Consignes des exercices",
"text": "Poussez avec le fessier de la jambe au sol, bassin horizontal."
},
{
"cat": "Consignes des exercices",
"text": "Remontez en levant les deux bras jusqu'à la verticale."
},
{
"cat": "Consignes des exercices",
"text": "Marchez avec les mains jusqu'en planche, dos gainé."
},
{
"cat": "Consignes des exercices",
"text": "Genou porteur fléchi, touchez le sol avec la main opposée."
},
{
"cat": "Consignes des exercices",
"text": "La qualité prime sur la vitesse, planche gainée 2 secondes."
},
{
"cat": "Consignes des exercices",
"text": "Fixez un point devant vous, bougez doucement les bras."
},
{
"cat": "Échauffements et étirements",
"text": "Marche sur place, rythme croissant"
},
{
"cat": "Échauffements et étirements",
"text": "Commencez doucement, puis accélérez progressivement."
},
{
"cat": "Échauffements et étirements",
"text": "Flexions-extensions des chevilles, assis"
},
{
"cat": "Échauffements et étirements",
"text": "Pointes de pied vers vous, puis vers le sol."
},
